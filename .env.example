# Beardslee St. Research — Environment Configuration
# Copy this file to .env and NEVER commit .env to version control.

# Server-side email allowlist (comma-separated, lowercase)
ALLOWED_EMAILS=isamalfuqaha@gmail.com,samuelnoginsky@gmail.com

# Generate scrypt password hashes by running: python3 set_passwords.py
AUTH_HASH_ISAM=""
AUTH_HASH_SAMUEL=""

# Alpaca Paper Trading API credentials (kept strictly server-side)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""

# Set to true when deploying behind HTTPS (Render, Railway, Nginx/Caddy TLS)
FORCE_HTTPS=false

# Session timeouts (seconds)
SESSION_IDLE_SECONDS=3600
SESSION_MAX_SECONDS=28800

# Set to false once ALPACA_API_KEY and ALPACA_SECRET_KEY are configured
DEMO_MODE=false
